{
  "name": "tablespark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A polished offline-first multiplication table generator and practice PWA.",
  "license": "MIT",
  "author": "Sanskar <sanskarin@outlook.in>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanskarIN/tablespark.git"
  },
  "homepage": "https://github.com/sanskarIN/tablespark#readme",
  "bugs": {
    "url": "https://github.com/sanskarIN/tablespark/issues"
  },
  "funding": "https://buymeacoffee.com/sanskarIN",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,json}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,json}\" \".vscode/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:security": "node --test scripts/secret-scanner.test.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:security && npm run secret:scan && npm run build"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
